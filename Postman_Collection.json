{
  "info": {
    "name": "Mini Project Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin@example.com", "type": "text" },
                { "key": "password", "value": "password123", "type": "text" }
              ]
            },
            "url": { "raw": "http://localhost:8000/login", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["login"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nidhin\",\n  \"email\": \"admin@example.com\",\n  \"role\": \"admin\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:8000/users/", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["users", ""] }
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "http://localhost:8000/users/?skip=0&limit=10", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["users", ""], "query": [ { "key": "skip", "value": "0" }, { "key": "limit", "value": "10" } ] }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API Testing\",\n  \"description\": \"Testing the API\"\n}"
            },
            "url": { "raw": "http://localhost:8000/projects/", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["projects", ""] }
          }
        },
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "http://localhost:8000/projects/?skip=0&limit=10", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["projects", ""] }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write auth logic\",\n  \"description\": \"Implement JWT\",\n  \"project_id\": 1,\n  \"assigned_to\": 1\n}"
            },
            "url": { "raw": "http://localhost:8000/tasks/", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["tasks", ""] }
          }
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "http://localhost:8000/tasks/", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["tasks", ""] }
          }
        }
      ]
    }
  ]
}
